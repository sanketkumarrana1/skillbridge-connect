# ==============================================================================
# AcadIn Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your project credentials.
#
# NOTE: Never commit .env or .env.local to version control.
# NOTE: Never add your Supabase service_role key to client-facing VITE_* variables.
# ==============================================================================

# 1. Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# 2. Application Base URL
VITE_APP_URL=http://localhost:8080

